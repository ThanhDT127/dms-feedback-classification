# === Azure AD App Registration (Client Credentials Flow) ===
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# === Gemini Backend ===
# "vertex" (default) = Vertex AI with GCP Service Account
# "apikey"           = Gemini API Key (free tier / personal)
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash-lite

# === Vertex AI (khi GEMINI_BACKEND=vertex) ===
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
# Path to Service Account JSON key file (mounted in Docker)
GCP_SERVICE_ACCOUNT_JSON=/app/data/sa-key.json

# === Local Model Artifacts ===
# Optional override. By default the service looks for Model/ under DATA_DIR.
MODEL_DIR=/app/data/Model

# === Gemini API Key (khi GEMINI_BACKEND=apikey) ===
# GEMINI_API_KEY=your-gemini-api-key-here

# === SharePoint Configuration ===
# Drive ID of the SharePoint document library
SHAREPOINT_DRIVE_ID=your-drive-id-here
# Item ID of the root "Phan_Loai_Phan_Hoi" folder
SHAREPOINT_ROOT_FOLDER_ID=your-root-folder-id-here

# === Polling Configuration ===
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# === Notification (optional — bỏ trống vẫn chạy) ===
# Microsoft Teams Incoming Webhook URL (ưu tiên nếu có)
TEAMS_WEBHOOK_URL=

# Email sender — phải là mailbox thật trong Azure AD tenant
# App cần quyền Mail.Send (Application permission + admin consent)
NOTIFICATION_SENDER_EMAIL=sender@your-org.com

# Email recipients — ngăn cách bằng dấu phẩy (hỗ trợ email ngoài tổ chức)
NOTIFICATION_RECIPIENTS=user1@example.com,user2@example.com

# Legacy (không dùng nữa, giữ backward compatible)
# NOTIFICATION_EMAIL=

# === LLM Configuration ===
# Batch size for LLM calls (default: 20)
LLM_BATCH_SIZE=20
# Checkpoint save interval (default: 50 rows)
CKPT_EVERY=50
