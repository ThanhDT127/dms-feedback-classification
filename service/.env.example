# === Azure AD App Registration (Client Credentials Flow) ===
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# === Gemini Backend ===
# "vertex" (default) = Vertex AI with GCP Service Account
# "apikey"           = Gemini API Key (free tier / personal)
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash-lite

# === Vertex AI (khi GEMINI_BACKEND=vertex) ===
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
# Path to Service Account JSON key file (mounted in Docker)
GCP_SERVICE_ACCOUNT_JSON=/app/data/sa-key.json

# === Local Model Artifacts ===
# Optional override. By default the service looks for Model/ under DATA_DIR.
MODEL_DIR=/app/data/Model

# === SharePoint-backed Config Asset Sync ===
# When enabled, the watcher checks SharePoint for tracked Keyword/ and Model/ asset updates
# before each polling cycle and reloads them between cycles if validation succeeds.
ENABLE_SHAREPOINT_CONFIG_SYNC=true
SHAREPOINT_KEYWORD_FOLDER=Keyword
SHAREPOINT_MODEL_FOLDER=Model

# === SharePoint Input Auto-upload ===
# When enabled, classification input files are automatically uploaded to the SharePoint Input folder
# at the start of each job. Set to false to disable.
# Large uploads automatically use Microsoft Graph upload sessions; no separate setting is required.
UPLOAD_INPUT_TO_SHAREPOINT=true

# === Runtime Cleanup ===
# Deletes temporary local artifacts after successful processing while preserving state files.
ENABLE_RUNTIME_CLEANUP=true
CLEANUP_OUTPUT_TTL_DAYS=7
CLEANUP_LOG_TTL_DAYS=7
CLEANUP_STAGING_TTL_HOURS=24

# === Gemini API Key (khi GEMINI_BACKEND=apikey) ===
# GEMINI_API_KEY=your-gemini-api-key-here

# === SharePoint Configuration ===
# Drive ID of the SharePoint document library
SHAREPOINT_DRIVE_ID=your-drive-id-here
# Item ID of the root "Phan_Loai_Phan_Hoi" folder
SHAREPOINT_ROOT_FOLDER_ID=your-root-folder-id-here

# === Polling Configuration ===
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# === Notification (optional â€” bá» trá»‘ng váº«n cháº¡y) ===
# Microsoft Teams Incoming Webhook URL (Æ°u tiÃªn náº¿u cÃ³)
TEAMS_WEBHOOK_URL=

# Email sender â€” pháº£i lÃ  mailbox tháº­t trong Azure AD tenant
# App cáº§n quyá»n Mail.Send (Application permission + admin consent)
NOTIFICATION_SENDER_EMAIL=sender@your-org.com

# Email recipients â€” ngÄƒn cÃ¡ch báº±ng dáº¥u pháº©y (há»— trá»£ email ngoÃ i tá»• chá»©c)
NOTIFICATION_RECIPIENTS=user1@example.com,user2@example.com

# Legacy (khÃ´ng dÃ¹ng ná»¯a, giá»¯ backward compatible)
# NOTIFICATION_EMAIL=

# === LLM Configuration ===
# Batch size for LLM calls (default: 20)
LLM_BATCH_SIZE=20
# Checkpoint save interval (default: 50 rows)
CKPT_EVERY=50

# === Gunicorn Configuration ===
# Sá»‘ lÆ°á»£ng workers cháº¡y FastAPI web server (default: 2)
# Má»—i worker sá»­ dá»¥ng event loop Uvicorn Ä‘á»™c láº­p Ä‘á»ƒ bypass GIL
GUNICORN_WORKERS=2

# === Concurrency & Worker Queue Configuration ===
# Sá»‘ luá»“ng worker cháº¡y ngáº§m xá»­ lÃ½ phÃ¢n loáº¡i file Excel tuáº§n tá»±/song song (default: 1)
# KhuyÃªn dÃ¹ng Ä‘áº·t báº±ng 1 Ä‘á»ƒ trÃ¡nh quÃ¡ táº£i háº¡n má»©c API Gemini (lá»—i 429)
CLASSIFICATION_WORKER_CONCURRENCY=1

# Giá»›i háº¡n sá»‘ job Ä‘ang xá»­ lÃ½ (running) tá»‘i Ä‘a cho má»—i ngÆ°á»i dÃ¹ng táº¡i má»™t thá»i Ä‘iá»ƒm (default: 1)
CLASSIFICATION_PER_USER_RUNNING_LIMIT=1

# Giá»›i háº¡n sá»‘ job náº±m trong hÃ ng Ä‘á»£i (queued) tá»‘i Ä‘a cho má»—i ngÆ°á»i dÃ¹ng (default: 3)
CLASSIFICATION_PER_USER_QUEUED_LIMIT=3

# Sá»‘ láº§n tá»± Ä‘á»™ng thá»­ láº¡i (retry) khi tÃ¡c vá»¥ phÃ¢n loáº¡i file bá»‹ lá»—i do sá»± cá»‘ máº¡ng hoáº·c rate limit (default: 2)
CLASSIFICATION_RETRY_COUNT=2

# Thá»i gian (giÃ¢y) Ä‘á»ƒ xÃ¡c Ä‘á»‹nh má»™t tÃ¡c vá»¥ bá»‹ treo (stale) vÃ  tá»± Ä‘á»™ng thu há»“i/cháº¡y láº¡i (default: 900 = 15 phÃºt)
CLASSIFICATION_STALE_RUNNING_TIMEOUT_SECONDS=900

# Worker idle poll interval in seconds (default: 1.0)
CLASSIFICATION_WORKER_POLL_INTERVAL_SECONDS=1.0

# Minimum heartbeat cadence while a job is running, used for stale job detection (default: 15.0)
CLASSIFICATION_WORKER_HEARTBEAT_SECONDS=15.0

# === Security / Authentication ===
# Environment: development | staging | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the web API.
# Use explicit origins in production, for example: https://dms.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# JWT signing key â€” REQUIRED, must be â‰¥ 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Admin password â€” leave empty to auto-generate a random password on first start.
# The generated password will be printed to the console.
DEFAULT_ADMIN_PASSWORD=


